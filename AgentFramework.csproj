<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<NoWarn>$(NoWarn);CA1812;OPENAI001;MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.AI" Version="1.3.0" />
		<PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.3.0" />
		<PackageReference Include="Microsoft.Agents.AI.DevUI" Version="1.3.0-preview.260423.1" />
		<PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.3.0" />
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.0" />
		
		<PackageReference Include="ModelContextProtocol" Version="1.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OllamaSharp" Version="5.4.25" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
	</ItemGroup>


	<ItemGroup>
		<Content Include="instructions/**" CopyToOutputDirectory="PreserveNewest" />
		<Content Include=".env" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.env')" />
	</ItemGroup>
</Project>
